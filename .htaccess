<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical English home URL
RewriteRule ^en/index\.html$ /en/ [L,R=301,NC]

# Redirect Trailing Slashes if not a directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Redirect extensionless URLs to .html when the target file exists
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ /$1.html [L,R=301]

# Redirect Non-WWW to WWW
RewriteCond %{HTTP_HOST} ^protoncd\.com\.br [NC]
RewriteRule ^(.*)$ https://www.protoncd.com.br/$1 [L,R=301]

# Ensure HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

</IfModule>
